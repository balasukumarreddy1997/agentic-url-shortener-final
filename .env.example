# Reference list of every environment variable the code reads.
# Nothing loads this file automatically: set variables in your shell before starting
# uvicorn, e.g. PowerShell:  $env:ALLOW_DEMO_AUTO_APPROVE = "1"

# SQLite file for short URLs and click events.
DATABASE_PATH=./url_shortener.db

# SQLite file for workflow runs, audit trail, decisions and metrics.
WORKFLOW_DB_PATH=./workflow_state.db

# Where agents write per-run evidence (requirements.json, test-evidence.json, ...).
# Defaults to <PROJECT_ROOT>/.agentic-artifacts
# AGENTIC_ARTIFACTS_DIR=./.agentic-artifacts

# Repository the agents inspect and run tests against. Defaults to the working directory.
# PROJECT_ROOT=.

# auto_approve skips every human gate. Off unless set to 1/true/yes. Local demos only.
# ALLOW_DEMO_AUTO_APPROVE=1
